<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_blanket_order_form" model="ir.ui.view">
        <field
            name="name"
        >sale_blanket_order_readonly_states.view_blanket_order_form</field>
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form" />
        <field name="arch" type="xml">
            <field name="line_ids" position="attributes">
                <attribute
                    name="readonly"
                >state in ('done','expired','cancel')</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute
                    name="readonly"
                >state in ('done','expired','cancel')</attribute>
            </field>
           <!--  <field name="partner_contact_id" position="attributes">
                <attribute
                    name="readonly"
                >state in ('done','expired','cancel')</attribute>
            </field> -->
            <field name="picking_policy" position="attributes">
                <attribute
                    name="readonly"
                >state in ('done','expired','cancel')</attribute>
            </field>
            <field name="partner_invoice_id" position="attributes">
                <attribute
                    name="readonly"
                >state in ('done','expired','cancel')</attribute>
            </field>
        </field>
    </record>

</odoo>
