<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="project_report_view_search" model="ir.ui.view">
        <field name="name">project.report.search</field>
        <field name="model">project.report</field>
        <field name="arch" type="xml">
            <search string="Project Analysis">
                <field name="project_id" />
                <field name="partner_id" />
                <field name="user_id" />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        string="Customer"
                        name="group_by_partner"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        string="Project Manager"
                        name="group_by_user"
                        context="{'group_by':'user_id'}"
                    />
                    <filter
                        string="Project"
                        name="group_by_project"
                        context="{'group_by':'project_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="project_report_view_list" model="ir.ui.view">
        <field name="name">project.report.list</field>
        <field name="model">project.report</field>
        <field name="arch" type="xml">
            <tree string="Project Analysis" create="0" edit="0" delete="0">
                <field name="project_id" />
                <field name="partner_id" />
                <field name="user_id" />
                <field name="planned_hours" />
                <field name="allocated_hours" />
                <field name="timesheet_hours" />
                <field name="invoiced_hours" />
                <field name="allocated_planned" widget="percentage" />
                <field name="timesheet_allocated" widget="percentage" />
                <field name="timesheet_planned" widget="percentage" />
                <button
                    name="action_open_project_updates"
                    type="object"
                    string="Project Updates"
                    icon="fa-external-link"
                />
            </tree>
        </field>
    </record>

    <record id="project_report_view_pivot" model="ir.ui.view">
        <field name="name">project.report.pivot</field>
        <field name="model">project.report</field>
        <field name="arch" type="xml">
            <pivot string="Project Analysis" sample="1">
                <field name="project_id" type="row" />
                <field name="planned_hours" type="measure" />
                <field name="allocated_hours" type="measure" />
                <field name="timesheet_hours" type="measure" />
                <field name="invoiced_hours" type="measure" />
                <field name="allocated_planned" type="measure" widget="percentage" />
                <field name="timesheet_allocated" type="measure" widget="percentage" />
                <field name="timesheet_planned" type="measure" widget="percentage" />
            </pivot>
        </field>
    </record>

    <record id="project_report_view_graph" model="ir.ui.view">
        <field name="name">project.report.graph</field>
        <field name="model">project.report</field>
        <field name="arch" type="xml">
            <graph string="Project Analysis" type="bar" sample="1">
                <field name="project_id" />
                <field name="planned_hours" type="measure" />
                <field name="allocated_hours" type="measure" />
                <field name="timesheet_hours" type="measure" />
                <field name="invoiced_hours" type="measure" />
                <field name="allocated_planned" type="measure" widget="percentage" />
                <field name="timesheet_allocated" type="measure" widget="percentage" />
                <field name="timesheet_planned" type="measure" widget="percentage" />
            </graph>
        </field>
    </record>

    <record id="project_report_action" model="ir.actions.act_window">
        <field name="name">Project Analysis</field>
        <field name="res_model">project.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="project_report_view_search" />
        <field name="context">{'group_by_no_leaf':1, 'group_by':[]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No data yet!
            </p>
            <p>
                Analyze the planned, allocated and recorded hours of your projects.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_project_report_analysis"
        name="Project Analysis"
        parent="project.menu_project_report"
        action="project_report_action"
        sequence="20"
        groups="project.group_project_user"
    />

</odoo>
