<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_picking_form" model="ir.ui.view">
    <field name="name">stock_sale_owner.view_picking_form</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    
    <field name="arch" type="xml">
      <!-- <xpath expr="//field[@name='owner_id']" position="before">
        <field name="picking_type_code" />
      </xpath> -->
      <xpath expr="//field[@name='owner_id']" position="attributes">
        <attribute name="invisible">picking_type_code not in ['incoming', 'outgoing']</attribute>
      </xpath>
      <!-- <xpath expr="//field[@name='owner_id']" position="replace">
        <field groups="stock.group_tracking_owner" name="owner_id" invisible="picking_type_code not in ['incoming', 'outgoing']"/>
      </xpath> -->
    </field>
  </record>

</odoo>
