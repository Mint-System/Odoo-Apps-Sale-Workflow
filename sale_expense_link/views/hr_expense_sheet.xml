<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">sale_expense_link.hr_expense_view_form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="account_move_id" invisible="1" />
                <button
                    name="action_open_so_lines"
                    class="oe_stat_button"
                    icon="fa-dollar"
                    type="object"
                    invisible="state not in ['approved', 'posted', 'in_payment', 'paid'] or not account_move_id"
                >
                    <span>Sale Order Lines</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>