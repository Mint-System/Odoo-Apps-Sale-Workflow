<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_notes" model="ir.ui.view">
        <field name="name">sale.view_order_form_notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <page name="order_lines" position="after">
                <page string="Text">
                    <group name="notes">
                        <span />
                        <label
                            class="fst-italic text-muted"
                        >These notes will be added to the pdf document.</label>

                        <label for="note_header" class="oe_inline" />
                        <field name="note_header" nolabel="1" />

                        <span />
                        <label
                            class="fst-italic text-muted"
                        >The header note is shown before the order lines.</label>

                        <label for="note_footer" class="oe_inline" />
                        <field name="note_footer" nolabel="1" />

                        <span />
                        <label
                            class="fst-italic text-muted"
                        >The footer note is shown after the order lines.</label>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
