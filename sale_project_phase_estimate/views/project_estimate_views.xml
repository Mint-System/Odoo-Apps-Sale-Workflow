<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_estimate_tree" model="ir.ui.view">
        <field name="name">sale_project_phase_estimate.project_estimate_tree</field>
        <field name="model">project.estimate</field>
        <field name="inherit_id" ref="project_phase_estimate.project_estimate_tree" />
        <field name="arch" type="xml">
            <field name="project_id" position="before">
                <field name="partner_id" invisible="1" />
                <field
                    name="sale_line_id"
                    domain="[('order_partner_id', '=', project_id), ('is_service', '=', True)]"
                />
                <field name="sale_order_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="project_estimate_filter" model="ir.ui.view">
        <field name="name">sale_project_phase_estimate.project_estimate_filter</field>
        <field name="model">project.estimate</field>
         <field
            name="inherit_id"
            ref="project_phase_estimate.project_estimate_filter"
        />
        <field name="arch" type="xml">
            <field name="phase_id" position="after">
                <field name="sale_line_id" string="Sale Order Line" />
                <field name="sale_order_id" string="Sale Order" />
            </field>
            <group position="inside">
                <filter
                    string="Sale Order"
                    name="sale_order"
                    context="{'group_by': 'sale_order_id'}"
                />
            </group>
        </field>
    </record>
</odoo>
