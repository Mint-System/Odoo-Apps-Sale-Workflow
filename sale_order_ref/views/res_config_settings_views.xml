<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sale_order_ref" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.order.ref</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='connectors_setting_container']" position="after">
                <block title="Sale Order Display" name="sale_order_ref_setting_block">
                    <setting id="sale_order_ref_template_setting"
                             string="Display Name Template"
                             title="Template used for sale order display names. Use {name} for order name and {ref} for client reference."
                             help="Define how sale order display names appear.">
                        <field name="sale_order_ref_displayname_template"
                               placeholder="e.g.: {name} ({ref})"/>
                        <div class="mt-2 text-muted">
                            Preview:
                            <field name="sale_order_ref_template_example"
                                   readonly="1"
                                   class="oe_inline fw-bold"/>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>

