<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="project_status">
        <t
            t-set="project_id"
            t-value="doc if doc._name == 'project.project' else (doc.timesheet_ids and doc.timesheet_ids[0].project_id or False)"
        />
        <t
            t-set="estimate_ids"
            t-value="project_id.estimate_ids.filtered(lambda rec: rec.is_in_progress) or False"
        />
        <t t-if="project_id and project_id.allow_estimate and estimate_ids">
            <div style="page-break-before: always;" />
            <div class="pt-5" />
            <div class="mt8">
                <h3>Project Status</h3>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th class="text-start">Phase</th>
                            <th class="text-end">Planned</th>
                            <th class="text-end">Effective</th>
                            <th class="text-end">Remaining</th>
                            <th class="text-end">Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="estimate_ids" t-as="estimate_id">
                            <td class="align-middle">
                                <span t-field="estimate_id.phase_id.name" />
                            </td>
                            <td class="text-end align-middle">
                                <span
                                    t-esc="estimate_id.planned_hours"
                                    t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"
                                />
                            </td>
                            <td class="text-end align-middle">
                                <span
                                    t-esc="estimate_id.effective_hours_validated"
                                    t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"
                                />
                            </td>
                            <td class="text-end align-middle">
                                <span
                                    t-esc="estimate_id.remaining_hours_validated"
                                    t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"
                                />
                            </td>
                            <td class="text-end align-middle">
                                <span
                                t-esc="estimate_id.progress_validated"
                                t-options="{'widget': 'integer'}"
                            /> %
                            </td>
                        </tr>
                        <tr>
                            <td class="text-end" colspan="1">
                                <strong>Total</strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <span
                                        t-esc="sum(estimate_ids.mapped('planned_hours'))"
                                        t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"
                                    />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <span
                                        t-esc="sum(estimate_ids.mapped('effective_hours_validated'))"
                                        t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"
                                    />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <span
                                        t-esc="sum(estimate_ids.mapped('remaining_hours_validated'))"
                                        t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"
                                    />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                <span
                                    t-esc="sum(estimate_ids.mapped('progress_validated')) / len(estimate_ids)"
                                    t-options="{'widget': 'integer'}"
                                /> %
                            </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="timesheet_sale_page" inherit_id="sale_timesheet.timesheet_sale_page">
        <xpath expr="//t[@t-call='hr_timesheet.timesheet_table']" position="after">
            <t t-call="sale_timesheet_estimate_report.project_status" />
        </xpath>
    </template>
</odoo>
