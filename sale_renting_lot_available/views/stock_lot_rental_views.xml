<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_lot_rental_form_view" model="ir.ui.view">
        <field name="name">sale_renting_lot_available.stock_lot_rental_form_view</field>
        <field name="model">stock.lot.rental</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name" />
                    <group>
                        <group>
                            <field name="lot_id" />
                            <field name="product_id" />
                            <field name="categ_id" />
                        </group>
                        <group>
                            <field name="so_line_id" />
                            <field name="sale_order_id" />
                            <field name="rental_status" />
                            <field name="is_late" />
                        </group>
                        <group>
                            <field name="start_date" />
                            <field name="return_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_lot_rental_list_view" model="ir.ui.view">
        <field name="name">sale_renting_lot_available.stock_lot_rental_list_view</field>
        <field name="model">stock.lot.rental</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name" />
                <field name="lot_id" />
                <field name="product_id" />
                <field name="categ_id" optional="hide" />
                <field name="sale_order_id" />
                <field name="so_line_id" optional="hide" />
                <field name="rental_status" />
                <field name="is_late" optional="show" />
                <field name="start_date" />
                <field name="return_date" />
            </list>
        </field>
    </record>

    <record id="stock_lot_rental_gantt_view" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_lot_available.stock_lot_rental_gantt_view</field>
        <field name="model">stock.lot.rental</field>
        <field name="arch" type="xml">
            <gantt
                date_start="start_date"
                date_stop="return_date"
                default_group_by="product_id,lot_id"
                scales="day,week,month,quarter,year"
            />
        </field>
    </record>

    <record id="stock_lot_rental_search_view" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_lot_available.stock_lot_rental_search_view</field>
        <field name="model">stock.lot.rental</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id" />
                <field name="product_id" />
                <field name="sale_order_id" />
                <field name="so_line_id" />
                <field name="rental_status" />
                <field name="categ_id" />
                <separator />
                <filter string="Late" name="late" domain="[('is_late', '=', True)]" />
                <group>
                    <filter
                        string="Product Category"
                        name="groupby_category"
                        domain="[]"
                        context="{'group_by': 'categ_id'}"
                    />
                    <filter
                        string="Rental Status"
                        name="groupby_status"
                        domain="[]"
                        context="{'group_by': 'rental_status'}"
                    />
                    <filter
                        string="Sale Order"
                        name="groupby_sale_order"
                        domain="[]"
                        context="{'group_by': 'sale_order_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_lot_rental_view" model="ir.actions.act_window">
        <field name="name">Rental Schedule</field>
        <field name="res_model">stock.lot.rental</field>
        <field name="view_mode">gantt,list,form</field>
        <field name="search_view_id" ref="stock_lot_rental_search_view" />
    </record>

    <record id="sale_renting.menu_rental_schedule" model="ir.ui.menu">
        <field name="action" ref="action_stock_lot_rental_view" />
    </record>
</odoo>
