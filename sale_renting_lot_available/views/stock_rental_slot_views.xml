<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_rental_slot_form_view" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_lot_available.stock_rental_slot_form_view</field>
        <field name="model">stock.rental.slot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_create_order"
                        string="Create Rental Order"
                        type="object"
                        invisible="sale_order_id"
                    />
                    <button
                        name="action_view_order"
                        string="View Rental Order"
                        type="object"
                        invisible="not sale_order_id"
                    />
                    <button
                        name="action_split_order_line"
                        string="Split Order Line"
                        type="object"
                        invisible="not sale_order_id and rental_status == 'return'"
                    />
                </header>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field
                                name="start_date"
                                widget="daterange"
                                options="{'end_date_field': 'return_date'}"
                                string="Rental Period"
                            />
                            <field name="return_date" invisible="1" />
                            <field name="order_partner_id" invisible="not so_line_id" />
                            <field name="is_placeholder" />
                        </group>
                        <group>
                            <field name="product_uom_qty" invisible="not so_line_id" />
                            <field name="product_id" />
                            <field name="categ_id" />
                            <field name="lot_id" />
                        </group>
                        <group>
                            <field name="so_line_id" />
                            <field name="sale_order_id" invisible="not so_line_id" />
                            <field name="rental_status" invisible="not so_line_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_rental_slot_list_view" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_lot_available.stock_rental_slot_list_view</field>
        <field name="model">stock.rental.slot</field>
        <field name="arch" type="xml">
            <list create="0" multi_edit="1" editable="bottom" open_form_view="True">
                <header>
                    <button
                        name="action_create_order"
                        string="Create Rental Order"
                        type="object"
                    />
                </header>
                <field name="name" />
                <field
                    name="start_date"
                    widget="daterange"
                    options="{'end_date_field': 'return_date'}"
                    string="Rental Period"
                />
                <field name="return_date" column_invisible="True" />
                <field name="order_partner_id" />
                <field name="product_id" />
                <field name="categ_id" optional="hide" />
                <field name="lot_id" optional="hide" />
                <field name="sale_order_id" />
                <field name="so_line_id" optional="hide" />
                <field
                    name="rental_status"
                    widget="badge"
                    decoration-warning="rental_status == 'pickup'"
                    decoration-info="rental_status == 'return'"
                    decoration-success="rental_status == 'returned'"
                />
            </list>
        </field>
    </record>

    <record id="stock_rental_slot_gantt_view" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_lot_available.stock_rental_slot_gantt_view</field>
        <field name="model">stock.rental.slot</field>
        <field name="arch" type="xml">
            <gantt
                date_start="start_date"
                date_stop="return_date"
                scales="day,week,month,quarter,year"
                pill_label="True"
                color="rental_color"
                on_create="sale_renting.action_create_rental_order"
            >
                <field name="rental_status" />

                <templates>
                    <t t-name="gantt-popover">
                        <ul class="list-unstyled m-0">
                            <li>
                                <strong>Status: </strong>
                                <t t-out="rental_status" />
                            </li>
                            <li>
                                <strong>Start: </strong>
                                <t t-out="start_date.toFormat('f')" />
                            </li>
                            <li>
                                <strong>End: </strong>
                                <t t-out="return_date.toFormat('f')" />
                            </li>
                        </ul>
                    </t>
                </templates>
            </gantt>
        </field>
    </record>

    <record id="stock_rental_slot_search_view" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_lot_available.stock_rental_slot_search_view</field>
        <field name="model">stock.rental.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="order_partner_id" />
                <field name="product_id" />
                <field name="lot_id" />
                <field name="categ_id" />
                <field name="rental_status" />
                <field name="sale_order_id" />
                <separator />
                <filter
                    string="Placeholder"
                    name="is_placeholder"
                    domain="[('is_placeholder', '=', True)]"
                />
                <filter
                    string="Has Order Line"
                    name="has_order_line"
                    domain="[('so_line_id', '!=', False)]"
                />
                <group>
                    <filter
                        string="Customer"
                        name="groupby_order_partner"
                        domain="[]"
                        context="{'group_by': 'order_partner_id'}"
                    />
                    <filter
                        string="Product Category"
                        name="groupby_category"
                        domain="[]"
                        context="{'group_by': 'categ_id'}"
                    />
                    <filter
                        string="Product"
                        name="groupby_product"
                        domain="[]"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        string="Lot"
                        name="groupby_lot"
                        domain="[]"
                        context="{'group_by': 'lot_id'}"
                    />
                    <filter
                        string="Rental Status"
                        name="groupby_status"
                        domain="[]"
                        context="{'group_by': 'rental_status'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_rental_slot_view" model="ir.actions.act_window">
        <field name="name">Rental Schedule</field>
        <field name="res_model">stock.rental.slot</field>
        <field name="view_mode">gantt,list,form</field>
        <field name="context">{
            "search_default_has_order_line": 1,
            "search_default_groupby_product": 1,
            "search_default_groupby_lot": 1,
        }</field>

        <field name="search_view_id" ref="stock_rental_slot_search_view" />
    </record>

    <record id="menu_rental_schedule_check_period" model="ir.ui.menu">
        <field name="name">Check Period</field>
        <field name="parent_id" ref="sale_renting.menu_rental_schedule" />
        <field name="action" ref="stock_rental_slot_period_act_window" />
        <field name="sequence">1</field>
    </record>

    <record id="menu_rental_schedule" model="ir.ui.menu">
        <field name="name">Schedule</field>
        <field name="parent_id" ref="sale_renting.menu_rental_schedule" />
        <field name="action" ref="action_stock_rental_slot_view" />
        <field name="sequence">2</field>
    </record>
</odoo>
