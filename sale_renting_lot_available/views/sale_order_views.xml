<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit_rental_slots" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental.slots</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_rental_slots"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar"
                >
                    <field
                        name="rental_slot_count"
                        widget="statinfo"
                        string="Rental Slots"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
