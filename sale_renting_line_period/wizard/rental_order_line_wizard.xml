<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rental_order_line_wizard_view_form" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_line_period.rental_order_line_wizard_view_form</field>
        <field name="model">rental.order.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Order Line">
                <sheet>
                    <group>
                        <group>
                            <field name="product_uom_qty" readonly="1" />
                        </group>
                    </group>
                    <p>
                        The order line will be split into one line per unit of
                        quantity, each with qty 1. This cannot be undone.
                    </p>

                    <footer>
                        <button
                            name="split"
                            string="Split"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"
                        />
                        <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rental_order_line_wizard_action" model="ir.actions.act_window">
        <field name="name">Split Order Line</field>
        <field name="res_model">rental.order.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="rental_order_line_wizard_view_form" />
        <field name="target">new</field>
    </record>
</odoo>
