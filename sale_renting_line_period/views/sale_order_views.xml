<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rental_order_form_view" model="ir.ui.view">
        <field name="name">sale_renting_line_period.rental_order_form_view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >rental_status in ['return', 'returned']</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list//field[@name='product_uom_qty']"
                position="before"
            >
                <field
                    name="rental_start_date"
                    string="Start Date"
                    widget="date"
                    column_invisible="not parent.is_rental_order"
                />
                <field
                    name="rental_return_date"
                    string="Return Date"
                    widget="date"
                    column_invisible="not parent.is_rental_order"
                />
                <field
                    name="duration_days"
                    string="Duration"
                    column_invisible="not parent.is_rental_order"
                    optional="hide"
                />
                <field
                    name="rental_status"
                    widget="badge"
                    options="{'color_field': 'rental_status_color'}"
                    column_invisible="not parent.is_rental_order"
                    optional="hide"
                />
                <field name="rental_status_color" column_invisible="True" />
                <field
                    name="reserved_lot_ids"
                    widget="many2many_tags"
                    optional="hide"
                    readonly="True"
                />
                <field
                    name="pickedup_lot_ids"
                    widget="many2many_tags"
                    optional="hide"
                    readonly="True"
                />
                <field
                    name="returned_lot_ids"
                    widget="many2many_tags"
                    optional="hide"
                    readonly="True"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list//field[@name='price_total']"
                position="after"
            >
                <button
                    name="action_split_line"
                    type="object"
                    icon="fa-cut"
                    string="Split Line"
                    invisible="product_uom_qty &lt;= 1"
                    column_invisible="not parent.is_rental_order"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <record id="rental_order_kanban_view" model="ir.ui.view">
        <field name="name">sale_renting_line_period.rental_order_kanban_view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_kanban" />
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="color">rental_status_color</attribute>
            </kanban>
            <xpath expr="//field[@name='has_rented_products']" position="after">
                <field name="rental_status_color" />
            </xpath>
            <xpath expr="//field[@name='rental_status']" position="attributes">
                <attribute name="widget">badge</attribute>
                <attribute
                    name="options"
                >{'color_field': 'rental_status_color'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="rental_order_list_view" model="ir.ui.view">
        <field name="name">sale_renting_line_period.rental_order_list_view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rental_status']" position="attributes">
                <attribute
                    name="options"
                >{'color_field': 'rental_status_color'}</attribute>
                <attribute name="decoration-info" />
                <attribute name="decoration-primary" />
                <attribute name="decoration-success" />
                <attribute name="decoration-warning" />
            </xpath>
            <xpath expr="//field[@name='rental_status']" position="after">
                <field name="rental_status_color" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <record id="rental_order_view_search" model="ir.ui.view">
        <field name="name">sale_renting_line_period.rental_order_view_search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_search" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', '|', '|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('ref', 'ilike', self), ('partner_id', 'child_of', self)]</attribute>
            </field>
        </field>
    </record>
</odoo>
