<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_line_view_form_readonly" model="ir.ui.view">
        <field
            name="name"
        >sale_renting_line_period.sale_order_line_view_form_readonly</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']/.." position="after">
                <field name="tracking" invisible="True" />
                <group invisible="tracking != 'serial'">
                    <field name="pickedup_lot_ids" widget="many2many_tags" />
                    <field name="returned_lot_ids" widget="many2many_tags" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
