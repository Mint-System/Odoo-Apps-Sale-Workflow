<?xml version='1.0' encoding='UTF-8' ?>
<odoo noupdate="1">
    <record id="seq_permit_number" model="ir.sequence">
        <field name="name">Permit Number</field>
        <field name="code">permit.number</field>

        <!-- 6 digits, leading zeros -->
        <field name="padding">6</field>

        <!-- incremental value -->
        <field name="number_increment">1</field>

        <!-- important: no gap implementation -->
        <field name="implementation">no_gap</field>
    </record>
</odoo>
